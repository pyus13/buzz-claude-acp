{
  "name": "buzz-claude-acp",
  "version": "1.0.0",
  "private": true,
  "description": "A Buzz harness plugin that runs Claude Code through the Agent Client Protocol, signed in with your own Claude account.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "icons": "node tools/icon/build.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "5.1.0"
  }
}
